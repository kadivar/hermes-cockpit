{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/gen from kernel/cockpitlib/pack_keys.py. Do not edit. Shapes only: the rules between keys stay in the loader (cockpit pack check).",
  "title": "migrate.yaml",
  "type": "object",
  "properties": {
    "board": {
      "description": "How the earlier board's cards are read.",
      "type": "object",
      "properties": {
        "flows": {
          "description": "The flow a card title means, each {pattern, flow}.",
          "type": "array",
          "items": {
            "properties": {
              "flow": {
                "description": "The flow.",
                "type": "string"
              },
              "pattern": {
                "description": "The title pattern.",
                "type": "string"
              }
            }
          }
        },
        "rewrite": {
          "description": "Title rewrites, each {pattern, replace}.",
          "type": "array",
          "items": {
            "properties": {
              "pattern": {
                "description": "The title pattern.",
                "type": "string"
              },
              "replace": {
                "description": "What replaces it.",
                "type": "string"
              }
            }
          }
        }
      }
    },
    "exporters": {
      "description": "The adopter's own commands that hand over what cockpit cannot read.",
      "type": "object",
      "properties": {
        "extra": {
          "description": "Further exports, each {name, argv}.",
          "type": "array",
          "items": {
            "properties": {
              "argv": {
                "description": "The export's command.",
                "type": "array"
              },
              "name": {
                "description": "The export's name.",
                "type": "string"
              }
            }
          }
        },
        "vault": {
          "description": "The export of the earlier secrets, as {argv, count_argv}.",
          "type": "object",
          "properties": {
            "argv": {
              "description": "Prints the secrets.",
              "type": "array"
            },
            "count_argv": {
              "description": "Prints how many there are.",
              "type": "array"
            }
          }
        }
      }
    },
    "legacy": {
      "description": "What an earlier pipeline left on the machine.",
      "type": "object",
      "properties": {
        "crons": {
          "description": "Cron jobs of the earlier pipeline.",
          "type": "object",
          "properties": {
            "replace": {
              "description": "Jobs cockpit's own replace.",
              "type": "array"
            },
            "retire": {
              "description": "Jobs removed.",
              "type": "array"
            }
          }
        },
        "editor_hooks": {
          "description": "Editor hooks of the earlier pipeline.",
          "type": "array"
        },
        "plugins": {
          "description": "Hermes plugins of the earlier pipeline.",
          "type": "object",
          "properties": {
            "disable": {
              "description": "Plugins turned off.",
              "type": "array"
            },
            "keep": {
              "description": "Plugins kept, each attached by extra_plugins.",
              "type": "array"
            }
          }
        },
        "profiles": {
          "description": "Hermes profiles of the earlier pipeline.",
          "type": "object",
          "properties": {
            "remove": {
              "description": "Profiles removed.",
              "type": "array"
            },
            "replace": {
              "description": "Profiles cockpit's seats replace.",
              "type": "array"
            }
          }
        },
        "root": {
          "description": "What is taken out of the root home.",
          "type": "object",
          "properties": {
            "config_drop": {
              "description": "Config keys dropped from the root config.",
              "type": "array"
            },
            "env_drop": {
              "description": "Environment names dropped from the root .env.",
              "type": "array"
            },
            "soul_blocks": {
              "description": "Blocks cut from the root soul, each {start, end}.",
              "type": "array",
              "items": {
                "properties": {
                  "end": {
                    "description": "The block's last line.",
                    "type": "string"
                  },
                  "start": {
                    "description": "The block's first line.",
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "shell_hooks": {
          "description": "Shell hooks of the earlier pipeline to remove, each {event, command}.",
          "type": "array",
          "items": {
            "properties": {
              "command": {
                "description": "The hook's command.",
                "type": "string"
              },
              "event": {
                "description": "The hook's event.",
                "type": "string"
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "records": {
      "description": "Where the earlier records go.",
      "type": "object",
      "properties": {
        "map": {
          "description": "Moves inside the workspace, each {from, to, kind}.",
          "type": "array",
          "items": {
            "properties": {
              "from": {
                "description": "The earlier place, relative to the workspace.",
                "type": "string"
              },
              "kind": {
                "description": "What is moved.",
                "type": "string",
                "enum": [
                  "dir",
                  "file",
                  "intents"
                ]
              },
              "to": {
                "description": "The new place, relative to the workspace.",
                "type": "string"
              }
            }
          }
        },
        "watch_id_prefixes": {
          "description": "How an earlier pipeline wrote a comment id in a watch record: its prefix, and which of inline:, issue: or review: it stands for; without it no such record is expected."
        }
      }
    },
    "slots": {
      "description": "The earlier slot bindings.",
      "type": "object",
      "properties": {
        "bindings": {
          "description": "Files that say who holds a slot, each {from (with {n}), to, format}.",
          "type": "array",
          "items": {
            "properties": {
              "format": {
                "description": "How the file is read.",
                "type": "string"
              },
              "from": {
                "description": "The earlier file; it names {n}.",
                "type": "string"
              },
              "to": {
                "description": "What the file tells.",
                "type": "string",
                "enum": [
                  "ticket",
                  "owner"
                ]
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
