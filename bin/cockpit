import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "kernel"))


def _run_on_the_plugin_venv():
    """A host whose `python3` lacks PyYAML (macOS ships one without it, and Hermes cron runs with a bare PATH) re-execs on the
    plugin's own venv when one exists beside it: `python3 -m venv .venv && .venv/bin/pip install -e .` in the plugin folder."""
    try:
        import yaml  # noqa: F401

        return
    except ImportError:
        pass
    root = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    venv = os.path.join(root, ".venv", "bin", "python")
    if (
        os.path.exists(venv)
        and os.path.realpath(sys.executable) != os.path.realpath(venv)
        and not os.environ.get("COCKPIT_NO_VENV")
    ):
        os.execv(venv, [venv, os.path.realpath(__file__), *sys.argv[1:]])  # noqa: S606 - this script again under the checkout's interpreter: a fixed argv, no shell


_run_on_the_plugin_venv()


def _complete_a_bare_path():
    """Hermes cron and the shell hook start without a login PATH. git, gh, gpg and hermes may live in a directory that PATH lacks
    (Homebrew on macOS or Linuxbrew, ~/bin, ~/.local/bin, Hermes's own bin): add the usual ones that exist, after what PATH
    already has. A helper's probe that cannot find kubectl in ~/bin would call a healthy stack down."""
    have = os.environ.get("PATH", "")
    parts = have.split(os.pathsep) if have else []
    home = os.path.expanduser("~")
    for extra in (
        "/usr/local/bin",
        "/opt/homebrew/bin",
        "/home/linuxbrew/.linuxbrew/bin",
        os.path.join(home, "bin"),
        os.path.join(home, ".local", "bin"),
        os.path.join(home, ".hermes", "bin"),
        os.path.dirname(sys.executable),
    ):
        if extra and extra not in parts and os.path.isdir(extra):
            parts.append(extra)
    os.environ["PATH"] = os.pathsep.join(parts)


_complete_a_bare_path()

from cockpitlib.cli import main  # noqa: E402 - the path is completed above, before the kernel can be imported

if __name__ == "__main__":
    raise SystemExit(main())
