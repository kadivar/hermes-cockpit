"""The references and schemas that are written from the code, so they cannot drift from it.

    scripts/gen           writes every generated file
    scripts/gen --check   regenerates into a temporary folder, compares with the committed files and exits 1 with the
                          list of the stale ones

Each generator reads a table the kernel itself runs on (the key registry, the command table, the intent schemas, the
pinned plugin API, doctor's checks) or scans the source for what no table holds (the notify events, the text of each
line doctor prints). Nothing here reads a
workspace, a pack or the machine's installation, and the same tree always gives the same bytes.
"""

import ast
import inspect
import json
import os
import sys
import tempfile

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
KERNEL = os.path.join(ROOT, "kernel", "cockpitlib")
_VENV = os.path.join(ROOT, ".venv", "bin", "python")
try:
    import yaml  # noqa: F401  the kernel's modules need it; a bare interpreter hands over to the project's own
except ModuleNotFoundError:
    if os.path.exists(_VENV) and os.path.realpath(sys.executable) != os.path.realpath(_VENV):
        os.execv(_VENV, [_VENV, os.path.abspath(__file__), *sys.argv[1:]])  # noqa: S606 - this script again under the checkout's interpreter: a fixed argv, no shell
    raise
sys.path.insert(0, os.path.join(ROOT, "kernel"))

REFERENCE = "docs/reference"
SCHEMA_DIR = "kernel/schema"


def _header(source: str) -> str:
    return f"<!-- Generated by scripts/gen from {source}. Do not edit: change the source and run scripts/gen. -->\n"


def _code(value) -> str:
    """A value as inline code that survives a table cell."""
    text = value if isinstance(value, str) else json.dumps(value, ensure_ascii=False, sort_keys=True)
    text = text.replace("|", "\\|").replace("\n", " ")
    fence = "``" if "`" in text else "`"
    pad = " " if text.startswith("`") or text.endswith("`") else ""
    return f"{fence}{pad}{text}{pad}{fence}"


def _cell(text: str) -> str:
    return str(text).replace("|", "\\|").replace("\n", " ")


def _table(head, rows) -> str:
    lines = ["| " + " | ".join(head) + " |", "|" + "---|" * len(head)]
    lines += ["| " + " | ".join(row) + " |" for row in rows]
    return "\n".join(lines) + "\n"


# ---- pack keys

WHEN_WORDS = {
    "absent": "",
    "none": " (also when the key has no value)",
    "blank": " (also when empty)",
    "falsy": " (also when empty or 0)",
    "not-list": " (for anything but a list with items)",
    "not-text": " (for anything but a text)",
}


def _default_cell(entry) -> str:
    from cockpitlib import pack_keys

    if "default" not in entry:
        return ""
    default = entry["default"]
    if isinstance(default, pack_keys.Key):
        shown = f"the value of `{default.path}`"
    else:
        shown = _code(json.dumps(pack_keys.default_of(entry), ensure_ascii=False))
    for path, test, value in entry.get("cases") or ():
        shown += f"; {_code(json.dumps(value))} when `{path}` is " + (
            "set" if test == pack_keys.TRUTHY else _code(json.dumps(test))
        )
    return shown + WHEN_WORDS[entry.get("when", "absent")]


def _notes_cell(entry) -> str:
    notes = []
    if entry.get("required"):
        notes.append("required")
    if "enum" in entry:
        notes.append("one of " + ", ".join(_code(item) for item in entry["enum"]))
    if "min" in entry or "max" in entry:
        notes.append(" to ".join(str(entry[side]) if side in entry else ("…") for side in ("min", "max")))
    if entry.get("security"):
        notes.append("security")
    return "; ".join(notes)


def _key_rows(entries) -> str:
    rows = [
        [
            f"`{entry['path']}`",
            entry["type"],
            _notes_cell(entry),
            _default_cell(entry),
            _cell(entry["doc"]),
            _code(entry["example"]) if "example" in entry else "",
        ]
        for entry in entries
    ]
    return _table(["Key", "Type", "Notes", "Default", "What it does", "Example"], rows)


def pack_keys_md() -> str:
    from cockpitlib import pack_keys

    out = [
        _header("kernel/cockpitlib/pack_keys.py"),
        "# Pack keys\n",
        "Every key a pack may set, by file and by block. `*` stands for a name the pack chooses and `[]` for each item of a "
        "list. *Notes* says when a key is required, the values or range it takes, "
        "and `security` for a key the fence, the gate or the vault reads. *Default* is the value in force when the pack "
        "leaves the key out; a blank cell means there is none (the feature is off, or the key is required). "
        "`cockpit pack explain <key>` prints the same for one key of the bound pack, with the value in force.\n",
        "In any string value of these files `{home}` is the reader's home folder and `{local.<name>}` is the value the "
        "optional `pack.local.yaml` beside `pack.yaml` gives that name; they are tokens of every file, not keys, and "
        "[customize/personal-values.md](../customize/personal-values.md) is their recipe.\n",
    ]
    for file in pack_keys.FILES:
        entries = pack_keys.entries(file)
        if not entries:
            continue
        out.append(f"## {file}\n")
        blocks, order = {}, []
        for entry in entries:
            head = pack_keys.segments(entry["path"])[0]
            if head not in blocks:
                blocks[head] = []
                order.append(head)
            blocks[head].append(entry)
        single = [blocks[head][0] for head in order if len(blocks[head]) == 1]
        if single:
            out.append("### Single keys\n")
            out.append(_key_rows(single))
        for head in order:
            if len(blocks[head]) > 1:
                out.append(f"### {head}\n")
                out.append(_key_rows(blocks[head]))
    return "\n".join(out)


# ---- schemas

SCALARS = {
    "str": "string",
    "path": "string",
    "url": "string",
    "regex": "string",
    "int": "integer",
    "number": "number",
    "bool": "boolean",
    "list": "array",
    "argv": "array",
    "map": "object",
}


# Keys the loader takes in more than one form (one name or a list of them), which the registry's one type cannot say:
# the schema leaves their type open. The fixture packs use both forms, and the schema test holds them to this.
MIXED = {
    ("pack.yaml", "skills_dir"),
    ("pack.yaml", "bump_sequence.stages[].field"),
    ("pack.yaml", "extra_plugins[].where"),
}


def _closed() -> dict:
    """{(file, place): key set} for every place whose validator refuses a key it does not know, read from the validator's
    own set so the schema says exactly what the loader says."""
    from cockpitlib import accounts, helpers, pack, pack_keys, pack_migration

    P = pack_keys
    return {
        (P.PACK, ""): set(pack.KNOWN),
        (P.PACK, "slots"): set(pack.SLOT_KEYS),
        (P.PACK, "tracker"): set(pack.TRACKER_KEYS),
        (P.PACK, "forge"): set(pack.FORGE_KEYS),
        (P.PACK, "advisor"): set(pack.ADVISOR_KEYS | pack.ADVISOR_OPTIONAL),
        (P.PACK, "mcp_servers.*"): set(pack.MCP_FIELDS),
        (P.PACK, "seat_config.*"): set(pack.SEAT_FIELDS),
        (P.HELPERS, "helpers.*"): set(helpers.HELPER_KEYS),
        (P.HELPERS, "groups.*"): set(helpers.GROUP_KEYS),
        (P.ACCOUNTS, "accounts[]"): set(accounts.KEYS),
        (P.MIGRATE, ""): set(pack_migration.SPEC_KEYS),
        (P.MIGRATE, "legacy"): set(pack_migration.LEGACY_KEYS),
    }


def _typed(entry) -> dict:
    """The shape of one key: its type (none for a key whose value has more than one form), enum and range."""
    from cockpitlib import pack_keys

    found = {"description": entry["doc"]}
    kind = entry["type"]
    if kind == "time":
        types = ["integer", "string"]
    elif entry.get("open") or (entry["file"], entry["path"]) in MIXED:
        types = []
    else:
        types = [SCALARS[kind]]
    if types and "default" in entry and entry.get("when", pack_keys.ABSENT) != pack_keys.ABSENT:
        types.append("null")  # the reader takes an empty value for the default, so the file may hold one
    if types:
        found["type"] = types[0] if len(types) == 1 else types
    if "enum" in entry:
        found["enum"] = list(entry["enum"]) + ([None] if "null" in types else [])
    if kind in ("int", "number"):
        for side, word in (("min", "minimum"), ("max", "maximum")):
            if side in entry:
                found[word] = entry[side]
    return found


def _node_schema(file, node, place, closed) -> dict:
    entry, children = node["entry"], node["children"]
    found = _typed(entry) if entry else {}
    if "[]" in children:
        found["items"] = _node_schema(file, children["[]"], place + "[]", closed)
        return found
    named = {name: child for name, child in children.items() if name != "*"}
    below = lambda name: f"{place}.{name}" if place else name
    if named:
        found["properties"] = {name: _node_schema(file, named[name], below(name), closed) for name in sorted(named)}
        required = sorted(name for name, child in named.items() if child["entry"] and child["entry"].get("required"))
        if required:
            found["required"] = required
    if "*" in children:
        found["additionalProperties"] = _node_schema(file, children["*"], below("*"), closed)
    elif (file, place) in closed:
        missing = closed[(file, place)] ^ set(named)
        if missing:
            raise SystemExit(
                f"scripts/gen: {file} {place or '(top)'}: the registry and the validator differ on {sorted(missing)}"
            )
        found["additionalProperties"] = False
    return found


def schemas() -> dict:
    from cockpitlib import notify, pack_effective, pack_keys

    closed = _closed()
    made = {}
    for file in pack_keys.FILES:
        body = _node_schema(file, pack_effective._tree(file), "", closed)
        if file == pack_keys.PACK:  # an event name has one shape, which the loader checks
            events = body["properties"]["notify"]
            events["patternProperties"] = {notify.EVENT.pattern: events.pop("additionalProperties")}
            events["additionalProperties"] = False
        schema = {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$comment": "Generated by scripts/gen from kernel/cockpitlib/pack_keys.py. Do not edit. Shapes only: the "
            "rules between keys stay in the loader (cockpit pack check).",
            "title": file,
            "type": "object",
            **body,
        }
        made[f"{SCHEMA_DIR}/{file.replace('.yaml', '')}.schema.json"] = (
            json.dumps(schema, indent=2, ensure_ascii=False) + "\n"
        )
    return made


# ---- the command line


def _doc(thing) -> str:
    return " ".join((inspect.getdoc(thing) or "").split())


def cli_md() -> str:
    from cockpitlib import cli, describe

    verbs = describe.verbs()
    usages = {}
    for name in sorted(vars(cli)):
        verb = name[: -len("_USAGE")].lower().replace("_", "-")
        if name.endswith("_USAGE") and verb in cli.COMMANDS and isinstance(getattr(cli, name), str):
            usages[verb] = getattr(cli, name)
    out = [
        _header("kernel/cockpitlib/cli.py (COMMANDS, EXAMPLES, FLAGS and each command's docstring)"),
        "# Command line\n",
        "Every `cockpit` command. A wrong argument prints the reason, the usage and an example, exits 2 and does not run. "
        "`cockpit describe --json` prints this table as data.\n",
        _table(
            ["Command", "Example"],
            [
                [f"[`{name}`](#{name})", _code(verbs[name]["example"]) if verbs[name]["example"] else ""]
                for name in verbs
            ],
        ),
    ]
    for name, row in verbs.items():
        out.append(f"## {name}\n")
        doc = _doc(cli.COMMANDS[name])
        if doc:
            out.append(doc + "\n")
        if name in usages:
            out.append("Usage:\n\n```\n" + usages[name].replace(" | ", "\n") + "\n```\n")
        if row["example"]:
            out.append("Example:\n\n```\n" + row["example"].replace(" | ", "\n") + "\n```\n")
        facts = []
        if row["flags"]:
            facts.append("Options: " + ", ".join(f"`{flag}`" for flag in row["flags"]) + ".")
        if row["self_parsed"]:
            facts.append("It checks its own options (the usage above lists them).")
        if row["zero_args"]:
            facts.append("It takes no argument.")
        if facts:
            out.append(" ".join(facts) + "\n")
    return "\n".join(out)


# ---- intents


def _flag(field: str) -> str:
    return "--" + field.replace("_", "-")


def intents_md() -> str:
    from cockpitlib import intents

    out = [
        _header("kernel/cockpitlib/intents.py (TYPES, SCHEMAS, FIELDS, EXAMPLES, TRANSITIONS)"),
        "# Intents\n",
        "An intent is one outward act, written as a file in the outbox. A lane writes it with "
        "`cockpit outbox new <ticket> <type> --card <card> --summary <text>` and the payload options below; nothing "
        "happens until it is endorsed and published.\n",
        "## Types\n",
    ]
    rows = []
    for kind in intents.TYPES:
        required, optional, one_of = intents.SCHEMAS[kind]
        rows.append(
            [
                f"`{kind}`",
                ", ".join(f"`{_flag(field)}`" for field in required),
                ", ".join(f"`{_flag(field)}`" for field in (*optional, "waits_for")),
                ", ".join(f"`{_flag(field)}`" for field in one_of),
                _code(intents.EXAMPLES[kind]) if intents.EXAMPLES[kind] else "",
            ]
        )
    out.append(_table(["Type", "Required", "Optional", "At least one of", "Example payload"], rows))
    out.append(
        "Never published by cockpit (the human acts and acknowledges): "
        + ", ".join(f"`{name}`" for name in intents.MANUAL_TYPES)
        + ". Pushes (a verify command runs on their range): "
        + ", ".join(f"`{name}`" for name in intents.PUSHES)
        + ".\n"
    )
    out.append("## Payload fields\n")
    shapes = {
        "text": "a text",
        "int": "a whole number",
        "list": "a list (comma-separated on the command line)",
        "files": "files (the option may repeat)",
        "file": "a file, copied beside the intent",
        "bool": "a switch",
        "intent": "another intent's id, like `TASK-100/001-push-branch`",
        "event": "one of " + ", ".join(f"`{event}`" for event in intents.EVENTS),
    }
    out.append(
        _table(
            ["Field", "Option", "Shape"],
            [[f"`{field}`", f"`{_flag(field)}`", shapes[shape]] for field, shape in intents.FIELDS.items()],
        )
    )
    out.append("## Statuses\n")
    out.append(
        "Open: "
        + ", ".join(f"`{name}`" for name in intents.OPEN_STATUSES)
        + ". Published: "
        + ", ".join(f"`{name}`" for name in intents.PUBLISHED)
        + ".\n"
    )
    out.append(
        _table(
            ["From", "May move to"],
            [
                [f"`{status}`", ", ".join(f"`{name}`" for name in sorted(moves)) or "(nothing)"]
                for status, moves in intents.TRANSITIONS.items()
            ],
        )
    )
    return "\n".join(out)


# ---- the plugin API


def plugin_api_md() -> str:
    from cockpitlib import plugin_api

    with open(os.path.join(ROOT, "tests", "contract", "cockpit-api.json"), encoding="utf-8") as handle:
        contract = json.load(handle)
    out = [
        _header("tests/contract/cockpit-api.json and the docstrings of kernel/cockpitlib/plugin_api.py"),
        "# Plugin API\n",
        f"`cockpitlib.plugin_api`, version {contract['api_version']} (the oldest version still served: "
        f"{contract['api_min_supported']}). A plugin calls `api.require(N)` first with the version it was built for. The "
        "signatures are pinned: a change to one fails the kernel's own tests.\n",
    ]
    for name in sorted(contract["functions"]):
        out.append(f"## {name}\n")
        out.append(f"```python\n{name}{contract['functions'][name]}\n```\n")
        doc = _doc(getattr(plugin_api, name, None))
        if doc:
            out.append(doc + "\n")
    return "\n".join(out)


# ---- notify events


def _sources():
    for folder, _dirs, names in sorted(os.walk(KERNEL)):
        for name in sorted(names):
            if name.endswith(".py") and name != "notify.py":
                path = os.path.join(folder, name)
                with open(path, encoding="utf-8") as handle:
                    yield os.path.relpath(path, KERNEL)[:-3].replace(os.sep, "."), ast.parse(handle.read())


def _shown(node) -> str:
    """An expression as a reader meets it: a text as it is, an f-string with its fields in angle brackets."""
    if isinstance(node, ast.Constant):
        return str(node.value)
    if isinstance(node, ast.JoinedStr):
        return "".join(
            str(part.value) if isinstance(part, ast.Constant) else "<" + ast.unparse(part.value) + ">"
            for part in node.values
        )
    if isinstance(node, ast.BinOp) and isinstance(node.op, ast.Add):
        return _shown(node.left) + _shown(node.right)
    return "<" + ast.unparse(node) + ">"


def _family(tree, function, event) -> list:
    """The names an f-string event takes: each constant the module passes for the parameter the event is built from."""
    names = [
        part.value.id
        for part in event.values
        if isinstance(part, ast.FormattedValue) and isinstance(part.value, ast.Name)
    ]
    params = [arg.arg for arg in function.args.args]
    if len(names) != 1 or names[0] not in params:
        return []
    index, found = params.index(names[0]), set()
    for call in ast.walk(tree):
        if isinstance(call, ast.Call) and isinstance(call.func, ast.Name) and call.func.id == function.name:
            given = (
                call.args[index]
                if len(call.args) > index
                else next((word.value for word in call.keywords if word.arg == names[0]), None)
            )
            for node in ast.walk(given) if given is not None else ():
                if isinstance(node, ast.Constant) and isinstance(node.value, str):
                    found.add(node.value)
    prefix = "".join(str(part.value) for part in event.values if isinstance(part, ast.Constant))
    return sorted(prefix + name for name in found)


def notify_events() -> list:
    """Every place the kernel sends an event: a call of notify.notify or notify.run, found in the source."""
    rows = []
    for module, tree in _sources():
        for function in ast.walk(tree):
            if not isinstance(function, (ast.FunctionDef, ast.AsyncFunctionDef)):
                continue
            senders = {
                alias.asname or alias.name
                for node in ast.walk(function)
                if isinstance(node, ast.ImportFrom) and node.module == "notify" and node.level == 1
                for alias in node.names
                if alias.name in ("notify", "run")
            }
            for call in ast.walk(function):
                if not (
                    isinstance(call, ast.Call)
                    and isinstance(call.func, ast.Name)
                    and call.func.id in senders
                    and len(call.args) >= 2
                ):
                    continue
                event = call.args[1]
                words = {word.arg: word.value for word in call.keywords if word.arg}
                key = call.args[2] if len(call.args) > 3 else words.get("key")
                body = call.args[3] if len(call.args) > 3 else call.args[2] if len(call.args) > 2 else None
                rows.append(
                    {
                        "event": _shown(event),
                        "names": _family(tree, function, event) if isinstance(event, ast.JoinedStr) else [],
                        "site": f"{module}.{function.name}",
                        "key": _shown(key) if key is not None else "",
                        "fields": sorted(name for name in words if name != "key"),
                        "body": _shown(body).strip().replace("\n", " ⏎ ")
                        if isinstance(body, (ast.JoinedStr, ast.Constant, ast.BinOp))
                        else "",
                        "once": call.func.id != "run" and "notify" in senders,
                    }
                )
    return sorted(rows, key=lambda row: (row["event"], row["site"]))


def events_md() -> str:
    from cockpitlib import notify

    out = [
        _header("every call into kernel/cockpitlib/notify.py, found by a scan of the kernel's source"),
        "# Notify events\n",
        "The events the kernel sends. A pack names one command per event under `notify` in `pack.yaml`; an event the pack "
        "does not name is not sent.\n",
        "## The command's contract\n",
        "From `kernel/cockpitlib/notify.py`:\n",
        "> " + _doc(notify) + "\n",
        f"- **Arguments:** `{{event}}`, `{{key}}` and the event's own fields (below) are filled into each word.\n"
        f"- **Environment:** the caller's, plus `COCKPIT_EVENT` and `COCKPIT_EVENT_KEY`.\n"
        f"- **Standard input:** the message body.\n"
        f"- **Exit code:** 0 is sent; anything else is a failure, reported with the last line the command printed.\n"
        f"- **Time limit:** {notify.TIMEOUT} seconds.\n"
        f"- **Event names** match `{notify.EVENT.pattern}`.\n",
        "## Events\n",
    ]
    rows = []
    for row in notify_events():
        name = f"`{row['event']}`" + (
            " (" + ", ".join(f"`{name}`" for name in row["names"]) + ")" if row["names"] else ""
        )
        rows.append(
            [
                name,
                f"`{row['site']}`",
                _code(row["key"]) if row["key"] else "",
                ", ".join(f"`{{{field}}}`" for field in row["fields"]),
                "once per key" if row["once"] else "each time the human sends it",
                _cell(row["body"]) or "(composed by the sender)",
            ]
        )
    out.append(_table(["Event", "Sent by", "Key", "Fields", "Sent", "Body"], rows))
    out.append("In *Key* and *Body*, a name in angle brackets is a value the kernel fills in.\n")
    return "\n".join(out)


# ---- doctor

# What stands on the page for each place a fix line names: doctor fills them in from the bound pack and the machine.
DOCTOR_PLACES = {"subject": "<subject>", "pack": "<pack>", "home": "<Hermes home>", "plugin": "<plugin>"}
DOCTOR_TIERS = (
    ("error", "Errors", "An error fails doctor and `cockpit setup`."),
    ("warning", "Warnings", "A warning is printed as `warning: …` and fails doctor only under `--strict`."),
    ("info", "Notes", "A note is printed as `note: …` after the verdict and never changes it."),
)


def _texts(node, names) -> list:
    """The texts an expression may be: a text, an f-string, a name bound to one in the same function, or each of a list."""
    if isinstance(node, (ast.JoinedStr, ast.BinOp)) or (isinstance(node, ast.Constant) and isinstance(node.value, str)):
        return [_shown(node)] if _shown(node) else []
    if isinstance(node, ast.Name):
        return names.get(node.id, [])
    if isinstance(node, ast.IfExp):
        return _texts(node.body, names) + _texts(node.orelse, names)
    if isinstance(node, ast.List):
        return [text for item in node.elts for text in _texts(item, names)]
    if isinstance(node, ast.Starred):
        return _texts(node.value, names)
    if isinstance(node, (ast.ListComp, ast.GeneratorExp)):
        return _texts(node.elt, names)
    return []


def _named_texts(function) -> dict:
    """{name: texts} of each name a function binds to a text."""
    return {
        node.targets[0].id: _texts(node.value, {})
        for node in ast.walk(function)
        if isinstance(node, ast.Assign)
        and len(node.targets) == 1
        and isinstance(node.targets[0], ast.Name)
        and isinstance(node.value, (ast.JoinedStr, ast.Constant))
    }


def _function_lines(function) -> list:
    """Every text a function may hand back as a line: what it returns, appends, extends or builds as a list."""
    names, found = _named_texts(function), []
    for node in ast.walk(function):
        if isinstance(node, ast.Return) and node.value is not None:
            found += _texts(node.value, names)
        elif (
            isinstance(node, ast.Call)
            and isinstance(node.func, ast.Attribute)
            and node.func.attr in ("append", "extend")
            and node.args
        ):
            found += _texts(node.args[0], names)
        elif isinstance(node, ast.AugAssign):
            found += _texts(node.value, names)
        elif isinstance(node, ast.Assign) and isinstance(node.value, (ast.List, ast.ListComp)):
            found += _texts(node.value, names)
    return found


def _module_functions(module: str) -> dict:
    with open(os.path.join(KERNEL, module + ".py"), encoding="utf-8") as handle:
        return {node.name: node for node in ast.parse(handle.read()).body if isinstance(node, ast.FunctionDef)}


class _DoctorScan:
    """The message of every `add("<id>", <message>)` call in doctor._collect, read from the source. A message written at
    the call is taken as it stands; one a called function hands back is followed into that function, and the check it
    lands on is asked of doctor's own sorter, so the page says what the code does."""

    def __init__(self):
        from cockpitlib import doctor

        self.doctor = doctor
        self.functions = _module_functions("doctor")
        self.collect = self.functions["_collect"]
        self.parents = {child: parent for parent in ast.walk(self.collect) for child in ast.iter_child_nodes(parent)}
        self.imported = {
            alias.asname or alias.name: (node.module, alias.name)
            for node in ast.walk(self.collect)
            if isinstance(node, ast.ImportFrom) and node.level == 1
            for alias in node.names
        }
        self.messages = {}

    def fail(self, call, why):
        raise SystemExit(f"scripts/gen: doctor._collect line {call.lineno}: {why}")

    def known(self, node) -> bool:
        return isinstance(node, ast.Constant) and node.value in self.doctor.CHECKS

    def function(self, name):
        """The definition behind a name _collect calls: one it imported, or one of doctor's own."""
        if name in self.imported:
            module, real = self.imported[name]
            return _module_functions(module).get(real)
        return self.functions.get(name)

    def source(self, node, name):
        """(target, function) for a name that holds a function's result where it is used: the nearest loop over that
        result, else the assignment in _collect. (None, None) for any other name."""
        holds = lambda target: name in [item.id for item in ast.walk(target) if isinstance(item, ast.Name)]
        at, bound = node, None
        while at in self.parents and bound is None:
            at = self.parents[at]
            if isinstance(at, ast.For) and holds(at.target):
                bound = (at.target, at.iter)
        if bound is None:
            bound = next(
                (
                    (item.targets[0], item.value)
                    for item in ast.walk(self.collect)
                    if isinstance(item, ast.Assign) and holds(item.targets[0])
                ),
                (None, None),
            )
        target, value = bound
        if isinstance(value, ast.Call) and isinstance(value.func, ast.Name):
            return target, value.func.id
        return None, None

    def keep(self, check_id, text):
        text = " ".join(text.split())
        if text and text not in self.messages.setdefault(check_id, []):
            self.messages[check_id].append(text)

    def answers(self, name) -> list:
        """Each {key: text} a function may return, for one that returns a mapping of lines (what Hermes said)."""
        function = self.function(name)
        names = _named_texts(function)
        return [
            {
                key.value: "".join(_texts(value, names)[:1])
                for key, value in zip(node.value.keys, node.value.values)
                if isinstance(key, ast.Constant)
            }
            for node in ast.walk(function)
            if isinstance(node, ast.Return) and isinstance(node.value, ast.Dict)
        ]

    def mapped(self, node):
        """(function, key) when an expression is name["key"] over a function's returned mapping, else None."""
        if (
            isinstance(node, ast.Subscript)
            and isinstance(node.value, ast.Name)
            and isinstance(node.slice, ast.Constant)
        ):
            function = self.source(node, node.value.id)[1]
            if function and self.function(function) is not None:
                return function, node.slice.value
        return None

    def from_mapping(self, call, first, message):
        """A line out of a returned mapping: each answer the function can give is one case."""
        function, key = self.mapped(message)
        choice = (
            isinstance(first, ast.IfExp)
            and self.mapped(first.test)
            and self.known(first.body)
            and self.known(first.orelse)
        )
        if not self.known(first) and not choice:
            self.fail(call, "the check of a line from a mapping is neither an id nor a choice between two ids")
        for answer in self.answers(function):
            if self.known(first):
                self.keep(first.value, answer.get(key, ""))
            else:
                self.keep(
                    first.body.value if answer.get(self.mapped(first.test)[1]) else first.orelse.value,
                    answer.get(key, ""),
                )

    def from_function(self, call, first, message):
        """A line a called function hands back: every line that function can build, under the check doctor sorts it to."""
        target, function = self.source(call, message.id)
        definition = self.function(function) if function else None
        if definition is None:
            self.fail(call, f"the message {message.id} does not come from a function this script can read")
        if isinstance(target, ast.Tuple):  # the function hands back (check, line) pairs
            pairs = [
                node
                for node in ast.walk(definition)
                if isinstance(node, ast.Tuple) and len(node.elts) == 2 and self.known(node.elts[0])
            ]
            if not pairs:
                self.fail(call, f"{function} hands back no (check, line) pair this script can read")
            for node in pairs:
                self.keep(node.elts[0].value, _shown(node.elts[1]))
            return
        sorter = None
        if isinstance(first, ast.Call) and isinstance(first.func, ast.Name):
            sorter = first.func.id
        elif isinstance(first, ast.Name):
            sorter = self.source(call, first.id)[1]
        if not self.known(first) and not (sorter and callable(getattr(self.doctor, sorter, None))):
            self.fail(call, "the check of a line is neither an id nor the answer of one of doctor's sorters")
        lines = _function_lines(definition)
        if not lines:
            self.fail(call, f"{function} builds no line this script can read")
        for text in lines:
            if self.known(first):
                self.keep(first.value, text)
                continue
            answer = getattr(self.doctor, sorter)(" ".join(text.split()))  # doctor's own sorter names the check
            self.keep(answer if isinstance(answer, str) else answer[0], text)

    def one(self, call):
        first, message = call.args[0], call.args[1]
        if self.mapped(message):
            return self.from_mapping(call, first, message)
        if isinstance(message, ast.Name):
            return self.from_function(call, first, message)
        texts = _texts(message, {})
        if not texts:
            self.fail(call, "the message is not a text this script can read")
        if self.known(first):
            ids = [first.value]
        elif isinstance(first, ast.IfExp) and self.known(first.body) and self.known(first.orelse):
            ids = [first.body.value, first.orelse.value]
        else:
            self.fail(call, "the check is not an id of doctor.CHECKS")
        for check_id in ids:
            self.keep(check_id, texts[0])

    def run(self) -> dict:
        for call in ast.walk(self.collect):
            if (
                isinstance(call, ast.Call)
                and isinstance(call.func, ast.Name)
                and call.func.id == "add"
                and len(call.args) >= 2
            ):
                self.one(call)
        return self.messages


def doctor_rows() -> list:
    """One row per registered check, in the registry's order: {id, severity, security, messages, fix}. The tier, the
    security mark and the fix come from doctor.CHECKS; the lines come from doctor._collect. A registered check with no
    line stops the generation, and so does a line under an id the registry lacks: the page never has a hole."""
    from cockpitlib import doctor, notify

    messages = _DoctorScan().run()
    silent = [check_id for check_id in doctor.CHECKS if not messages.get(check_id)]
    if silent:
        raise SystemExit(f"scripts/gen: doctor: registered checks with no line in doctor._collect: {silent}")
    places = {**DOCTOR_PLACES, "verified": " or ".join(doctor.HERMES_VERIFIED), "events": ", ".join(notify.EVENTS)}
    return [
        {
            "id": check_id,
            "severity": spec["severity"],
            "security": spec["security"],
            "messages": messages[check_id],
            "fix": spec["fix"].format(**places),
        }
        for check_id, spec in doctor.CHECKS.items()
    ]


def doctor_md() -> str:
    from cockpitlib import doctor

    rows = doctor_rows()
    out = [
        _header("kernel/cockpitlib/doctor.py (CHECKS, and the lines doctor._collect prints under each check)"),
        "# Doctor\n",
        "`cockpit doctor` checks the bound workspace and this machine's installation. Every finding belongs to one "
        "registered check with a fixed tier: no flag, environment variable or pack key changes the tier of a check. "
        "Doctor prints the errors, then the warnings, each followed by a `fix:` line, and exits 1 when there is an error; "
        "otherwise it prints `doctor: OK` (with the count of warnings) and exits 0. `--strict` makes a warning fail too, "
        "`--online` adds the probes that need the network, and `--json` prints the verdict and every finding as data. "
        "`cockpit setup` ends with the same checks.\n",
        f"Hermes versions this kernel was checked against: {', '.join(doctor.HERMES_VERIFIED)}. A newer minor is accepted, "
        "with a note, only when a live probe of its hooks answers the recorded shapes.\n",
        "A check marked **security** guards a boundary (the fence, the stored secrets, a seat's isolation): each is an "
        "error, and the list of them is pinned by `tests/contract/doctor-security.json`. In a line, a name in angle "
        "brackets is a value doctor fills in. *What resolves it* is the `fix:` line doctor prints under the finding; in it, `<subject>` is what the line is about, `<pack>` the pack's "
        "folder, `<Hermes home>` the Hermes home and `<plugin>` this plugin's folder.\n",
    ]
    for severity, title, meaning in DOCTOR_TIERS:
        tier = [row for row in rows if row["severity"] == severity]
        out.append(f"## {title}\n")
        out.append(meaning + "\n")
        out.append(
            _table(
                ["Check", "Security", "Line", "What resolves it"],
                [
                    [
                        f"`{row['id']}`",
                        "**security**" if row["security"] else "",
                        "<br>".join(_code(text) for text in row["messages"]),
                        _code(row["fix"]) if row["fix"] else "",
                    ]
                    for row in tier
                ],
            )
        )
    return "\n".join(out)


# ---- writing and checking


def generated() -> dict:
    """{path relative to the repository: text} of everything this script owns."""
    return {
        f"{REFERENCE}/pack-keys.md": pack_keys_md(),
        f"{REFERENCE}/cli.md": cli_md(),
        f"{REFERENCE}/intents.md": intents_md(),
        f"{REFERENCE}/plugin-api.md": plugin_api_md(),
        f"{REFERENCE}/events.md": events_md(),
        f"{REFERENCE}/doctor.md": doctor_md(),
        **schemas(),
    }


def write(folder: str) -> list:
    made = generated()
    for path, text in made.items():
        target = os.path.join(folder, path)
        os.makedirs(os.path.dirname(target), exist_ok=True)
        with open(target, "w", encoding="utf-8") as handle:
            handle.write(text if text.endswith("\n") else text + "\n")
    return sorted(made)


def stale(root: str = ROOT) -> list:
    """The generated files whose text under that root is not what the code gives now."""
    with tempfile.TemporaryDirectory(prefix="cockpit-gen-") as folder:
        found = []
        for path in write(folder):
            try:
                with open(os.path.join(root, path), encoding="utf-8") as handle:
                    committed = handle.read()
            except OSError:
                committed = None
            with open(os.path.join(folder, path), encoding="utf-8") as handle:
                if handle.read() != committed:
                    found.append(path)
        return found


def main(argv) -> int:
    if argv not in ([], ["--check"]):
        print("usage: scripts/gen [--check]", file=sys.stderr)
        return 2
    if argv:
        found = stale()
        if found:
            print("stale generated files (run scripts/gen):\n" + "\n".join(f"  {path}" for path in found))
            return 1
        print("generated files are current")
        return 0
    for path in write(ROOT):
        print(path)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
