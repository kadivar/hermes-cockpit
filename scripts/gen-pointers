#!/usr/bin/env python3
# SPDX-FileCopyrightText: 2026 Mohammadreza Kadivar
# SPDX-License-Identifier: AGPL-3.0-or-later
"""Write the entry files other coding assistants read, each a pointer of a few lines to AGENTS.md and the contribute
skill. They are generated so they cannot drift: `scripts/gen-pointers` rewrites them, `--check` fails when one differs.

Standard library only, and no syntax newer than Python 3.9.
"""

import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
GUIDE = "AGENTS.md"
SKILL = ".agents/skills/contribute/SKILL.md"
NOTE = "<!-- generated by scripts/gen-pointers from AGENTS.md: edit that file, never this one -->"
RULE = f"Read `{GUIDE}` at the repository root and follow it."
FIRST = f"For any change, first read `{SKILL}` in full and follow it."
FOLLOW = f"Read `{SKILL}` in full and follow it: this file is only a pointer to it."

# A rule pointer: the assistant reads it at the start of a session. A skill pointer: found by the skill's name.
RULES = ("CLAUDE.md", ".github/copilot-instructions.md")
RULE_WITH_HEAD = ".cursor/rules/contribute.mdc"
SKILLS = (".claude/skills/contribute/SKILL.md", ".cursor/skills/contribute/SKILL.md")
POINTERS = (*RULES, RULE_WITH_HEAD, *SKILLS)


def frontmatter(text: str) -> str:
    """A file's frontmatter block, both rules included, or '' when it has none."""
    lines = text.splitlines()
    if not lines or lines[0].strip() != "---":
        return ""
    for index in range(1, len(lines)):
        if lines[index].strip() == "---":
            return "\n".join(lines[: index + 1]) + "\n"
    return ""


def field(head: str, name: str) -> str:
    """One field's line of a frontmatter block, as written."""
    for line in head.splitlines():
        if line.startswith(name + ":"):
            return line
    return ""


def wanted(root: str = ROOT) -> dict:
    """Every pointer file with the text it must hold, from the skill's own frontmatter."""
    head = frontmatter(open(os.path.join(root, SKILL), encoding="utf-8").read())
    if not head or not field(head, "name") or not field(head, "description"):
        raise SystemExit(f"scripts/gen-pointers: {SKILL} has no frontmatter with a name and a description")
    found = {path: f"{NOTE}\n\n{RULE}\n{FIRST}\n" for path in RULES}
    # this editor loads a rule file by its own head: the skill's description, and a switch that applies it always
    found[RULE_WITH_HEAD] = f"---\n{field(head, 'description')}\nalwaysApply: true\n---\n{NOTE}\n\n{RULE}\n{FIRST}\n"
    found.update({path: f"{head}{NOTE}\n\n{FOLLOW}\n" for path in SKILLS})
    return found


def main(argv) -> int:
    if argv not in ([], ["--check"]):
        print("usage: scripts/gen-pointers [--check]", file=sys.stderr)
        return 2
    stale = []
    for path, text in sorted(wanted().items()):
        full = os.path.join(ROOT, path)
        have = open(full, encoding="utf-8").read() if os.path.isfile(full) else None
        if have == text:
            continue
        stale.append(path)
        if not argv:
            os.makedirs(os.path.dirname(full), exist_ok=True)
            with open(full, "w", encoding="utf-8") as out:
                out.write(text)
            print(f"wrote {path}")
    if argv and stale:
        print("stale pointer files (run scripts/gen-pointers): " + ", ".join(stale))
        return 1
    if not stale:
        print("pointers ok")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
