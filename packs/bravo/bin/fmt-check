# Fixture verify command: the pushed range may not add a line ending in a space.
base=$1; sha=$2
if git diff "$base...$sha" | grep -q '^+.* $'; then echo "north fmt: trailing space in $base...$sha"; exit 1; fi
echo "north fmt: clean"
