# Fixture exporter for the invented "tide" pipeline: reads $COCKPIT_ROOT/tide-logins.jsonl.
file="$COCKPIT_ROOT/tide-logins.jsonl"
if [ "$1" = count ]; then [ -f "$file" ] && grep -c . "$file" || echo 0; exit 0; fi
[ -n "$TIDE_DUMP_FAIL" ] && exit 4
[ -f "$file" ] && cat "$file"
exit 0
