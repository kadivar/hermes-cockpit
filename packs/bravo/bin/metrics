# Fixture perf hook: posts the record path; NORTH_METRICS_DOWN fails it.
[ -n "$NORTH_METRICS_DOWN" ] && { echo "north metrics sink closed" >&2; exit 6; }
printf "north-metrics %s %s\n" "$2" "$1" >> "$COCKPIT_ROOT/perf.log"
