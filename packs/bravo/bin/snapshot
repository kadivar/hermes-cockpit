# Fixture export step: NORTH_SNAPSHOT_DOWN names the target that fails.
[ "$NORTH_SNAPSHOT_DOWN" = "$2" ] && { echo "north snapshot $2 offline" >&2; exit 7; }
printf "north-snapshot %s %s\n" "$2" "$1" >> "$COCKPIT_ROOT/export.log"
