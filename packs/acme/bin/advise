# Fixture advisor: answers $ACME_ADVICE (default APPROVED) for the checkpoint; "fail" exits 1; the query is logged.
printf "acme-advise|%s|%s\n" "$2" "$(head -c 200 "$1" | tr '\n' ' ')" >> "$COCKPIT_ROOT/advise.log"
[ "$ACME_ADVICE" = "fail" ] && { echo "acme advisor offline" >&2; exit 1; }
printf "%s\nbecause the acme plan says so\n" "${ACME_ADVICE:-APPROVED}"
