# Fixture notifier: one line per message in $COCKPIT_ROOT/notified.log; FAIL in the body fails the send.
body=$(cat)
case "$body" in *FAIL*) echo "acme pager down" >&2; exit 3;; esac
printf "acme|%s|%s|%s\n" "$COCKPIT_EVENT" "$*" "$body" >> "$COCKPIT_ROOT/notified.log"
